            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json)}}",
        "options": {}
      }
    },
    {
      "name": "Build CRM Import Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2190,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const imported = items.map((item) => item.json);\nconst config = $('Set CRM Growth Config').first().json;\nreturn [{\n  json: {\n    imported_count: imported.length,\n    imported_prospect_ids: imported.map((row) => row.prospect_id || row[0]?.prospect_id).filter(Boolean),\n    dispatch_to_v4: config.dispatch_to_v4,\n    child_workflow_id_v4: config.child_workflow_id_v4,\n    child_workflow_id_v3: config.child_workflow_id_v3,\n    child_workflow_label_v3: config.child_workflow_label_v3,\n    batch_fetch_limit: config.batch_fetch_limit,\n    daily_send_limit: config.daily_send_limit,\n    max_attempts_per_prospect: config.max_attempts_per_prospect,\n    min_confidence_score: config.min_confidence_score,\n    batch_run_label: config.batch_run_label,\n    booking_link_45min: config.booking_link_45min,\n    ingest_label: config.ingest_label\n  }\n}];"
      }
