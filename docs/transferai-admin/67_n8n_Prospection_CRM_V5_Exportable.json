      "name": "Upsert Prospects Into CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1940,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/prospect_targets?on_conflict=prospect_id'}}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
