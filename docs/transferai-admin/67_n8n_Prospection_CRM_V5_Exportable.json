              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Fetch Today Outreach Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2910,
        420
      ],
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL + '/rest/v1/outreach_attempts?select=id&sent_at=gte.' + new Date().toISOString().slice(0,10)}}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Build End Of Run Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3150,
        420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crmRows = Array.isArray($json) ? $json : Array.isArray($json.data) ? $json.data : [];\nlet outreachRows = [];\ntry {\n  const snap = $('Fetch Today Outreach Snapshot').first().json;\n  outreachRows = Array.isArray(snap) ? snap : Array.isArray(snap.data) ? snap.data : [];\n} catch (e) {}\nconst importSummary = $('Build CRM Import Summary').first().json;\nreturn [{\n  json: {\n    crm_stage: 'v5_growth_loop_completed',\n    imported_count: importSummary.imported_count || 0,\n    crm_ready_count: crmRows.length,\n    outreach_today_count: outreachRows.length,\n    dispatch_to_v4: importSummary.dispatch_to_v4,\n    child_workflow_id_v4: importSummary.child_workflow_id_v4 || null,\n    child_workflow_id_v3: importSummary.child_workflow_id_v3 || null,\n    child_workflow_label_v3: importSummary.child_workflow_label_v3 || null,\n    batch_fetch_limit: importSummary.batch_fetch_limit || null,\n    daily_send_limit: importSummary.daily_send_limit || null,\n    next_step: importSummary.dispatch_to_v4 ? 'V4 batch can now process the CRM queue with the configured V3 enhanced workflow.' : 'CRM queue updated without dispatch.',\n    generated_at: new Date().toISOString()\n  }\n}];"
      }
    }
