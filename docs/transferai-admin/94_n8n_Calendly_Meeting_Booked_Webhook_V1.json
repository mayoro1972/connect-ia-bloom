    {
      "parameters": {
        "jsCode": "const item = $input.all()[0].json;\nconst body = (item.body && typeof item.body === 'object') ? item.body : item;\nconst payload = body.payload || {};\n\nfunction clean(v) {\n  if (v === undefined || v === null) return '';\n  const s = String(v).trim();\n  return (s === 'undefined' || s === 'null') ? '' : s;\n}\n\nconst eventType = clean(body.event || '');\n\nif (eventType !== 'invitee.created') {\n  return [];\n}\n\n// Calendly payload: invitee data is directly in payload (not payload.invitee)\nconst inviteeEmail = clean(payload.email || '');\nif (!inviteeEmail) {\n  return [];\n}\n\n// scheduled_event data may be nested — grab what's available\nconst scheduledEvent = payload.scheduled_event || {};\n\nreturn [{\n  json: {\n    event_type: eventType,\n    invitee_email: inviteeEmail,\n    invitee_name: clean(payload.name || ''),\n    start_time: clean(scheduledEvent.start_time || ''),\n    end_time: clean(scheduledEvent.end_time || ''),\n    event_name: clean(scheduledEvent.name || ''),\n    cancel_url: clean(payload.cancel_url || ''),\n    reschedule_url: clean(payload.reschedule_url || ''),\n    booked_at: new Date().toISOString()\n  }\n}];"
      },
