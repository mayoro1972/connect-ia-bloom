    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const rows = Array.isArray($json) ? $json : Array.isArray($json.data) ? $json.data : [$json];\nconst prospect = rows[0] || {};\n\nconst ctx = $('Parse Calendly Event').first().json || {};\n\nif (!prospect.prospect_id) {\n  return [];\n}\n\nreturn {\n  json: {\n    prospect_id: prospect.prospect_id,\n    target_email: prospect.target_email,\n    current_status: prospect.status,\n    invitee_email: ctx.invitee_email,\n    invitee_name: ctx.invitee_name,\n    start_time: ctx.start_time,\n    end_time: ctx.end_time,\n    event_name: ctx.event_name,\n    cancel_url: ctx.cancel_url,\n    reschedule_url: ctx.reschedule_url,\n    booked_at: ctx.booked_at\n  }\n};"
      },
