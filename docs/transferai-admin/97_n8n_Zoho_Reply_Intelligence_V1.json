{
  "name": "TransferAI Zoho Reply Intelligence V1",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 15 }]
        }
      },
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-600, 300],
      "id": "zri-0001-0001-0001-000000000001"
    },
    {
      "parameters": {
        "mailbox": "INBOX",
        "options": {
          "unseen": true,
          "since": "={{ new Date(Date.now() - 16 * 60 * 1000).toISOString() }}"
