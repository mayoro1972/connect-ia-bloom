        "jsCode": "const item = $input.all()[0].json;\nconst body = (item.body && typeof item.body === 'object') ? item.body : item;\n\nconst eventType = String(body.type || '');\nconst data = body.data || {};\nconst tags = data.tags || {};\n\nconst prospectId = tags.prospect_id || '';\nconst toEmail = (Array.isArray(data.to) && data.to[0]) ? data.to[0] : '';\n\nconst actionableEvents = ['email.bounced', 'email.complained'];\n\nif (!actionableEvents.includes(eventType) || !prospectId) {\n  return [];\n}\n\nconst stopReason = eventType === 'email.bounced' ? 'email_bounced' : 'email_complained';\n\nreturn [{\n  json: {\n    event_type: eventType,\n    prospect_id: prospectId,\n    to_email: toEmail,\n    stop_reason: stopReason,\n    detected_at: new Date().toISOString()\n  }\n}];"
