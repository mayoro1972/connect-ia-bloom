      "parameters": {
        "jsCode": "\nconst p = $json;\nconst prenom = (p.decision_maker_name||'').split(' ')[0] || 'Madame/Monsieur';\nconst email2_body = `<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;color:#222\">\n<p>Bonjour {{prenom}},</p>\n<p>Suite à votre inscription, nous avons le plaisir de vous faire parvenir le <strong>programme détaillé</strong> de notre formation <strong>L'IA appliquée à votre métier</strong>.</p>\n<p>Vous trouverez en pièce jointe le programme complet (PDF). Voici les points essentiels :</p>\n<h3 style=\"color:#1a56db;font-size:15px;margin:20px 0 8px\">📋 Ce que vous allez maîtriser en 2 jours</h3>\n<ul>\n<li><strong>Jour 1 :</strong> Panorama IA &amp; confidentialité · Courriers &amp; emails · Réunions &amp; briefings · Comptes rendus</li>\n<li><strong>Jour 2 :</strong> Classement &amp; GED · Notes de synthèse · Bibliothèque de prompts · Charte interne IA</li>\n</ul>\n<h3 style=\"color:#1a56db;font-size:15px;margin:20px 0 8px\">🎓 Vous repartez avec</h3>\n<ul>\n<li>✅ Attestation de formation <strong>TransferAI &amp; Nettelecom CI</strong></li>\n<li>✅ Kit de prompts / Templates IA adaptés à votre métier</li>\n<li>✅ Support PDF complet + Bibliothèque de prompts métier</li>\n<li>✅ Check-list protection données sensibles + Mini-charte interne</li>\n</ul>\n<h3 style=\"color:#1a56db;font-size:15px;margin:20px 0 8px\">📅 Sessions disponibles</h3>\n<ul>\n<li>Session 1 — <strong>30-31 juillet 2026</strong></li>\n<li>Session 2 — <strong>10-11 août 2026</strong></li>\n</ul>\n<p><strong>Lieu :</strong> Riviera 3, carrefour Sainte Famille, Abidjan, Côte d'Ivoire<br>\n<strong>Tarif :</strong> À partir de 250 000 F CFA / personne · Réductions groupe disponibles</p>\n<p>Pour confirmer votre place ou poser une question :</p>\n<p style=\"text-align:center;margin:28px 0\">\n<a href=\"{{google_form_url}}\" style=\"background:#1a56db;color:#fff;padding:12px 24px;border-radius:6px;text-decoration:none;font-weight:bold;margin-right:10px\">Je confirme mon inscription</a>\n<a href=\"{{calendly_url}}\" style=\"background:#ffffff;color:#1a56db;padding:12px 24px;border-radius:6px;text-decoration:none;font-weight:bold;border:1px solid #1a56db\">Réserver un appel</a>\n</p>\n<p style=\"font-size:13px;color:#666\">WhatsApp &amp; Agent IA : <strong>+225 07 16 57 39 90</strong></p>\n<p>Bien cordialement,<br><strong>L'équipe TransferAI Nettelecom CI</strong><br>\nWhatsApp &amp; Agent IA : +225 07 16 57 39 90<br>\nEmail : contact@transferai.ci<br>\nRiviera 3, carrefour Sainte Famille, Abidjan, Côte d'Ivoire</p>\n</div>`\n  .replace('{{prenom}}', prenom)\n  .replace('{{google_form_url}}', 'https://docs.google.com/forms/d/e/1FAIpQLSf8qtoXBTusqppHwdIoVfyXX9n12UbKBg34_bmAyxNzFPC_xA/viewform')\n  .replace('{{calendly_url}}', 'https://calendly.com/contact-transferai/appel-decouverte-formation-ia-pratique');\n\nconst notes = p.notes_internal || '';\nconst nb = (notes.match(/Nb: ([^|]+)/)||['','1'])[1].trim();\nconst date_pref = (notes.match(/Date: ([^|]+)/)||['',''])[1].trim();\n\nconst admin_html = `<div style=\"font-family:Arial,sans-serif;max-width:640px;margin:0 auto\">\n<h2 style=\"color:#1a56db\">Validation requise — Email 2 : Programme formation</h2>\n<table style=\"width:100%;border-collapse:collapse;font-size:13px;margin-bottom:16px\">\n<tr><td style=\"padding:6px;border:1px solid #e5e7eb;font-weight:bold;width:130px\">Prospect</td><td style=\"padding:6px;border:1px solid #e5e7eb\">{{nom}} — {{structure}}</td></tr>\n<tr><td style=\"padding:6px;border:1px solid #e5e7eb;font-weight:bold\">Email</td><td style=\"padding:6px;border:1px solid #e5e7eb\">{{email}}</td></tr>\n<tr><td style=\"padding:6px;border:1px solid #e5e7eb;font-weight:bold\">Secteur</td><td style=\"padding:6px;border:1px solid #e5e7eb\">{{secteur}}</td></tr>\n<tr><td style=\"padding:6px;border:1px solid #e5e7eb;font-weight:bold\">Nb personnes</td><td style=\"padding:6px;border:1px solid #e5e7eb\">{{nb_personnes}}</td></tr>\n</table>\n<h3 style=\"font-size:14px;color:#374151\">Aperçu de l'email 2 :</h3>\n<div style=\"border:1px solid #e5e7eb;border-radius:6px;padding:16px;background:#f9fafb;margin-bottom:20px\">\n{{preview_html}}\n</div>\n<p style=\"text-align:center;margin:24px 0\">\n<a href=\"https://n8n-pxlk.srv1480638.hstgr.cloud/webhook/formation-email2-approve?decision=approve&prospect_id={{prospect_id}}&email=2\" style=\"background:#059669;color:#fff;padding:12px 20px;border-radius:6px;text-decoration:none;font-weight:bold;margin:4px\">✅ Approuver &amp; Envoyer</a>\n<a href=\"https://n8n-pxlk.srv1480638.hstgr.cloud/webhook/formation-email2-approve?decision=amend&prospect_id={{prospect_id}}&email=2\" style=\"background:#f59e0b;color:#fff;padding:12px 20px;border-radius:6px;text-decoration:none;font-weight:bold;margin:4px\">✏️ Amender</a>\n<a href=\"https://n8n-pxlk.srv1480638.hstgr.cloud/webhook/formation-email2-approve?decision=refuse&prospect_id={{prospect_id}}&email=2\" style=\"background:#dc2626;color:#fff;padding:12px 20px;border-radius:6px;text-decoration:none;font-weight:bold;margin:4px\">❌ Refuser</a>\n</p>\n</div> `\n  .replace('{{nom}}', p.decision_maker_name||'Inconnu')\n  .replace('{{structure}}', p.organization_name||'-')\n  .replace('{{email}}', p.target_email||'-')\n  .replace('{{secteur}}', p.sector_guess||'-')\n  .replace('{{nb_personnes}}', nb||'1')\n  .replace('{{prospect_id}}', p.prospect_id)\n  .replace('{{prospect_id}}', p.prospect_id)\n  .replace('{{prospect_id}}', p.prospect_id)\n  .replace('{{preview_html}}', email2_body.substring(0,800)+'...');\n\nreturn [{json: {\n  prospect_id: p.prospect_id,\n  nom: p.decision_maker_name,\n  email: p.target_email,\n  structure: p.organization_name,\n  secteur: p.sector_guess,\n  prenom,\n  email2_body,\n  admin_html,\n  pdf_url: 'https://wlhznciwuofueffyoflo.supabase.co/storage/v1/object/public/prospecting-artifacts/formation/programme_formation_ia_2026.pdf'\n}}];\n"
      }
