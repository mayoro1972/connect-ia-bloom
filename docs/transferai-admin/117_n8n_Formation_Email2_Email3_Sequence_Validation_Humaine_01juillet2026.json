auto\">\n<h2 style=\"color:#1a56db\">Validation requise — Email 3 : Relance urgente — places limitées</h2>\n<table style=\"width:100%;border-collapse:collapse;font-size:13px;margin-bottom:16px\">\n<tr><td style=\"padding:6px;border:1px solid #e5e7eb;font-weight:bold;width:130px\">Prospect</td><td style=\"padding:6px;border:1px solid #e5e7eb\">{{nom}} — {{structure}}</td></tr>\n<tr><td style=\"padding:6px;border:1px solid #e5e7eb;font-weight:bold\">Email</td><td style=\"padding:6px;border:1px solid #e5e7eb\">{{email}}</td></tr>\n<tr><td style=\"padding:6px;border:1px solid #e5e7eb;font-weight:bold\">Secteur</td><td style=\"padding:6px;border:1px solid #e5e7eb\">{{secteur}}</td></tr>\n<tr><td style=\"padding:6px;border:1px solid #e5e7eb;font-weight:bold\">Nb personnes</td><td style=\"padding:6px;border:1px solid #e5e7eb\">{{nb_personnes}}</td></tr>\n</table>\n<h3 style=\"font-size:14px;color:#374151\">Aperçu de l'email 3 :</h3>\n<div style=\"border:1px solid #e5e7eb;border-radius:6px;padding:16px;background:#f9fafb;margin-bottom:20px\">\n{{preview_html}}\n</div>\n<p style=\"text-align:center;margin:24px 0\">\n<a href=\"https://n8n-pxlk.srv1480638.hstgr.cloud/webhook/formation-email3-approve?decision=approve&prospect_id={{prospect_id}}&email=3\" style=\"background:#059669;color:#fff;padding:12px 20px;border-radius:6px;text-decoration:none;font-weight:bold;margin:4px\">✅ Approuver &amp; Envoyer</a>\n<a href=\"https://n8n-pxlk.srv1480638.hstgr.cloud/webhook/formation-email3-approve?decision=amend&prospect_id={{prospect_id}}&email=3\" style=\"background:#f59e0b;color:#fff;padding:12px 20px;border-radius:6px;text-decoration:none;font-weight:bold;margin:4px\">✏️ Amender</a>\n<a href=\"https://n8n-pxlk.srv1480638.hstgr.cloud/webhook/formation-email3-approve?decision=refuse&prospect_id={{prospect_id}}&email=3\" style=\"background:#dc2626;color:#fff;padding:12px 20px;border-radius:6px;text-decoration:none;font-weight:bold;margin:4px\">❌ Refuser</a>\n</p>\n</div>`\n  .replace(/{{nom}}/g,p.decision_maker_name||'')\n  .replace(/{{structure}}/g,p.organization_name||'')\n  .replace(/{{email}}/g,p.target_email||'')\n  .replace(/{{secteur}}/g,p.sector_guess||'')\n  .replace(/{{nb_personnes}}/g,'')\n  .replace(/{{prospect_id}}/g,p.prospect_id)\n  .replace('{{preview_html}}',email3_body.substring(0,600)+'...');\nreturn [{json:{...p,prenom,email3_body,admin_html}}];\n"
